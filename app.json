{
  "expo": {
    "name": "vi-sante",
    "slug": "vi-sante",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vi-sante",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visante.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Vi-Santé utilise l'appareil photo pour scanner les QR codes et prendre des photos de profil",
        "NSPhotoLibraryUsageDescription": "Vi-Santé accède à votre galerie pour sélectionner une photo de profil",
        "NSPhotoLibraryAddUsageDescription": "Vi-Santé peut enregistrer des images dans votre galerie",
        "NSUserTrackingUsageDescription": "Vi-Santé utilise ces informations pour améliorer votre expérience et personnaliser les recommandations de santé"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.visante.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2563EB",
          "mode": "production"
        }
      ],
      [
        "expo-tracking-transparency"
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
